# Скопируйте в .env: cp .env.example .env
# Один .env работает и для локального запуска (make local / make run),
# и для Docker (make up / make prod-up): в контейнере POSTGRES_DSN и
# REDIS_ADDR подменяются адресами внутри сети compose.

# --- Обязательные ---
MAX_BOT_TOKEN=
# Для локального запуска бота на хосте (Postgres и Redis из make deps-up)
POSTGRES_DSN=postgres://bot:bot@localhost:5432/bot?sslmode=disable
REDIS_ADDR=localhost:6379

# --- Postgres в docker compose ---
# В проде обязательно задайте свой DB_PASSWORD (и поправьте POSTGRES_DSN выше).
DB_USER=bot
DB_PASSWORD=bot
DB_NAME=bot
# Порты на localhost для локального запуска (при конфликте поменяйте и DSN/REDIS_ADDR)
DB_PORT=5432
REDIS_PORT=6379
BOT_HTTP_PORT=8080
# Файл переменных для контейнера бота (по умолчанию этот .env).
# BOT_ENV_FILE=/etc/maxhouse/bot.env

# --- Приём обновлений MAX ---
# webhook — MAX присылает обновления на WEBHOOK_URL (нужен сертификат Минцифры);
# longpoll — бот сам опрашивает MAX, WEBHOOK_URL и WEBHOOK_SECRET не нужны.
UPDATES_MODE=longpoll
# Сколько MAX держит запрос /updates без новых обновлений (1s–90s)
LONGPOLL_TIMEOUT=30s
# Только для UPDATES_MODE=webhook:
WEBHOOK_URL=https://example.ngrok-free.app/webhook
WEBHOOK_SECRET=change-me
# Только для prod (make prod-up): домен, на который выпущен сертификат;
# WEBHOOK_URL и UPDATES_MODE=webhook prod-compose задаёт сам из домена.
# WEBHOOK_SECRET: 5–256 символов, латиница, цифры, _ и - (openssl rand -hex 32).
# WEBHOOK_DOMAIN=bot.example.ru
# WEBHOOK_CERTS_DIR=./deploy/certs   # fullchain.pem и privkey.pem

# --- Режим и логи ---
APP_ENV=dev
LOG_LEVEL=
LOG_FILE_PATH=/var/log/bot/bot.log
LOG_MAX_SIZE_MB=50
LOG_MAX_BACKUPS=7
LOG_MAX_AGE_DAYS=14

# --- Контроль доступа ---
# true: новый чат активируется сразу; false: статус pending до подтверждения
# организатором (UPDATE house_chats SET status = 'active' WHERE id = ...,
# см. README, «Работа с данными»).
AUTO_CHAT_REGISTRATION=true

# --- HTTP / webhook ---
HTTP_ADDR=:8080
# Остановка: сколько бот дорабатывает принятые обновления после SIGTERM.
# BOT_STOP_GRACE_PERIOD (docker compose) должен быть больше SHUTDOWN_TIMEOUT.
SHUTDOWN_TIMEOUT=20s
BOT_STOP_GRACE_PERIOD=30s
# Часовой пояс времени в сообщениях (материалы, кулдаун рассылки)
DISPLAY_TIMEZONE=Europe/Moscow
UPDATE_DEDUP_TTL=24h

# --- Вызовы MAX: повторы и таймауты ---
MAX_RETRY_ATTEMPTS=3
MAX_RETRY_BASE_DELAY=500ms
MAX_RETRY_MAX_DELAY=5s
MAX_CALL_TIMEOUT=5s

# --- FSM ---
FSM_TTL=30m
# Сессия в личке: активный дом и показанное приветствие
SESSION_TTL=24h

# --- Заявки ---
# Заявок каждого типа в сутки на жителя в доме (отдельно жалобы, инициативы, опросы)
DAILY_REQUEST_LIMIT=3
VOTING_DURATION=72h
REQUEST_TTL_DEFAULT=14d
# Текст заявки, символов (сообщение MAX — до 4000 вместе с шапкой карточки)
REQUEST_BODY_MAX_LEN=3000
REQUEST_MAX_ATTACHMENTS=10
# Сколько заявок показывать в списках в личке
LIST_PAGE_SIZE=10
BROADCAST_COOLDOWN=24h

# --- Планировщик ---
SCHEDULER_INTERVAL=1m
# Сколько заявок одна задача обрабатывает за тик
SCHEDULER_BATCH_SIZE=100

# --- Рейтинг ---
RATING_MIN_VOTES=1
RATING_CONFIRM_SHARE=0.5
RATING_REFUTE_SHARE=0.5
RATING_DELTA_CONFIRMED=1
RATING_DELTA_REFUTED=1
RATING_MIN_TO_CREATE=-3
RATING_APPLIES_TO_TYPES=all
# Как часто обнулять отрицательные рейтинги (длительность: 7d, 14d, 12h; m — минуты)
RATING_RESET_INTERVAL=7d

# --- Сообщить о проблеме ---
# Оповещение в домовой чат, когда за окно (от первого сообщения) о проблеме
# сообщили столько разных жителей
PROBLEM_ALERT_THRESHOLD=3
PROBLEM_ALERT_WINDOW=30m
